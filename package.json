{
  "name": "rein",
  "displayName": "rein - guardrails for AI-written code",
  "description": "Checks the code your AI assistant writes: leaked secrets, unsafe calls, and imports that do not resolve, shown inline before you commit or run. Deterministic, no LLM. Powered by the rein engine.",
  "version": "0.1.0",
  "publisher": "sametatas",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "rein",
    "copilot",
    "cursor",
    "ai",
    "agent",
    "secrets",
    "security",
    "hallucinated imports",
    "python",
    "guardrails"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SametAtas/rein-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/SametAtas/rein-vscode/issues"
  },
  "homepage": "https://rein.software",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:python"
  ],
  "contributes": {
    "languageModelTools": [
      {
        "name": "rein_review",
        "displayName": "rein: review code",
        "modelDescription": "After writing or editing Python code, run rein to check it for leaked secrets, unsafe calls, and unresolved or hallucinated imports before finalizing. Pass the code as `code` and, when known, the file path as `filename`. Returns the findings to fix.",
        "userDescription": "Run rein to check code for leaked secrets, unsafe calls, and unresolved imports.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "rein",
        "tags": [
          "rein"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "The source code to review."
            },
            "filename": {
              "type": "string",
              "description": "Path or name for the code, used in findings and path-based rules. Defaults to snippet.py."
            }
          },
          "required": [
            "code"
          ]
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "rein.review",
        "name": "rein",
        "fullName": "rein",
        "description": "Review code with the rein engine: leaked secrets, unsafe calls, and imports that do not resolve.",
        "commands": [
          {
            "name": "review",
            "description": "Review the pasted code block, editor selection, or current file."
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "rein.reviewFile",
        "title": "rein: Review Current File"
      },
      {
        "command": "rein.reviewWorkspace",
        "title": "rein: Review Workspace"
      },
      {
        "command": "rein.reviewStaged",
        "title": "rein: Review Staged Changes"
      },
      {
        "command": "rein.checkCommitMessage",
        "title": "rein: Check Commit Message"
      },
      {
        "command": "rein.showOutput",
        "title": "rein: Show Log"
      }
    ],
    "configuration": {
      "title": "rein",
      "properties": {
        "rein.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable rein diagnostics."
        },
        "rein.path": {
          "type": "string",
          "default": "",
          "description": "Path to the rein executable. Empty means search PATH."
        },
        "rein.run": {
          "type": "string",
          "enum": [
            "onSaveAndOpen",
            "onSave",
            "manual"
          ],
          "default": "onSaveAndOpen",
          "description": "When to review a file automatically."
        },
        "rein.explain": {
          "type": "boolean",
          "default": true,
          "description": "Include remediation guidance from rein (--explain)."
        },
        "rein.severityThreshold": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "info",
          "description": "Hide findings below this severity."
        },
        "rein.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to rein review (e.g. [\"--bandit\"])."
        },
        "rein.baseline": {
          "type": "string",
          "default": "",
          "description": "Path to a rein baseline file (--baseline)."
        },
        "rein.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to a .rein.toml config file (--config)."
        },
        "rein.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "description": "Skip files larger than this size in kilobytes."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.4.0"
  }
}
